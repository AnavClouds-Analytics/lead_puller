# ============================================================================
#  Lead Puller 2.2 settings. Copy this file to .env and fill in the first part.
#  To change anything later: edit the line, then run   docker compose up -d
#  (a plain "docker compose restart" does NOT re-read this file). No code changes are ever needed.
#  Seamless API keys and the MillionVerifier key are added on the Accounts page in the tool.
# ============================================================================


# ---- Login ---------------------------------------------------------------------
APP_PASSWORD=change-me-to-a-long-password
#   Password for the tool
SESSION_DAYS=30
#   Days before you have to log in again
COOKIE_SECURE=1
#   1 once the site is on HTTPS (it should be); 0 only for local testing

# ---- Keys ----------------------------------------------------------------------
SEAMLESS_API_KEY=
#   Optional. Seamless keys are normally added on the Accounts page; a key here shows up there as one more account
ANTHROPIC_API_KEY=
#   Optional. Only for the "Describe it" box (console.anthropic.com → API Keys)
CLAUDE_MODEL=claude-sonnet-5-5
#   Claude model used by the "Describe it" box

# ---- Spending ------------------------------------------------------------------
SPENDING_ENABLED=1
#   0 = master switch: nothing is searched or researched
MONTHLY_CREDIT_BUDGET=9500
#   Max credits per calendar month, all accounts together (0 = no limit)
ACCOUNT_RESERVE=50
#   Never take an account's balance below this; the next account is used instead
LOW_BALANCE_WARNING=500
#   Warning banner when an account's balance is below this (0 = off)
DEFAULT_TARGET=1000
#   Emails pre-filled in "Contacts with email" on a new pull
DEFAULT_MAX_CREDITS_PER_EMAIL=1.3
#   Max credits pre-filled on a new pull = target × this (you can change it per pull)

# ---- Saving credits ------------------------------------------------------------
REQUIRE_COMPANY_WEBSITE=1
#   Skip people whose company has no website before paying (no website = almost never a work email)
SKIP_NO_EMAIL_SERVER=1
#   Skip companies whose domain can't receive email (free DNS check) before paying
MAX_PER_COMPANY=3
#   Default max people per company in one pull (0 = no limit)
UPDATED_WITHIN_MONTHS=12
#   Default for new pulls: only contacts Seamless updated in the last N months (fresher = more emails; 0 = any)
SLICE_BY_COMPANY_SIZE=1
#   Split each search by company size and track every slice, so expensive slices are left for later
MOVE_ON_SEARCH_COST=1.0
#   Move to the next slice when finding each new email costs more than this many search credits
MOVE_ON_PAGES=3
#   …measured over this many search pages
FRESH_RESCAN=1
#   When a search has been fully scanned, later runs ask Seamless only for people updated since then
BANK_DAYS=14
#   People found but not needed (target reached) are kept and used first by the next pull with the same filters, for this many days
SYNC_SEAMLESS_SAVED=1
#   Add everyone already researched in your Seamless accounts (website, Chrome extension) to the already-pulled memory, so they're never paid for again (free)
SAVED_SYNC_HOURS=24
#   How often to re-read your Seamless saved contacts
SAVED_LOOKBACK_DAYS=730
#   How far back to read saved contacts the first time
SAVED_MAX_PAGES=60
#   Max pages of 500 saved contacts read per sync
FIRST_BATCH=25
#   The first research batch of every pull is this small; the email rate is checked before sending more
PAUSE_BELOW_EMAIL_RATE=30
#   If fewer than this % of that first batch have an email, the pull pauses and asks before spending more (0 = off)
EXPECTED_EMAIL_RATE=80
#   % of researched people expected to have an email, until your own history says otherwise

# ---- Email guessing ------------------------------------------------------------
EMAIL_GUESSING=1
#   Before paying Seamless for a person, guess their email from their company's known format and check it with MillionVerifier; only a "valid" answer is used, anything else is paid for in Seamless as usual (0 = off)
GUESS_PROBE=1
#   2.2: at a company whose email format isn't known yet, try the common full-name formats (first.last@, firstlast@, first_last@) with MillionVerifier before paying Seamless to learn it (0 = always pay for the first person, as in 2.1)
GUESS_PROBE_FORMATS=3
#   How many of those formats to try for that first person (1-3)
GUESS_MAX_COMPANY_SIZE=5000
#   2.2: never guess at companies bigger than this many employees (more people share a name there); 0 = no limit
GUESS_MAX_CHECKS_PER_PERSON=2
#   Most MillionVerifier checks for one person before paying Seamless (a 2nd only when the company uses two formats)
GUESS_MIN_CHECKS_LEFT=200
#   Stop guessing (and pay Seamless as usual) when MillionVerifier has fewer checks left than this
GUESS_STOP_BELOW_RATE=40
#   Stop guessing at a company once fewer than this % of its guesses came back valid (after 3 guesses)
GUESS_INITIAL_FORMATS=0
#   1 = also guess initial formats (jsmith@, j.smith@) when nobody else seen at the company would share the address. Off by default: another J. Smith there could own it. Formats like john@ are never guessed
GUESS_PER_STEP=10
#   Guesses checked per step, so Pause and Stop always answer quickly
GUESS_TIMEOUT_SECONDS=10
#   MillionVerifier answer time limit per check (2–60); a slow answer counts as not valid, never as valid
GUESS_CACHE_DAYS=30
#   Reuse a MillionVerifier answer for the same address for this many days instead of paying for it again
GUESS_ERRORS_PAUSE=3
#   After this many MillionVerifier errors in a row, stop guessing for 30 minutes and pay Seamless as usual
MILLIONVERIFIER_API_KEY=
#   Optional. The MillionVerifier key is normally added on the Accounts page; a key here is used when none is set there
MILLIONVERIFIER_BASE_URL=https://api.millionverifier.com/api/v3
#   MillionVerifier API address

# ---- Company lists -------------------------------------------------------------
DEFAULT_PER_COMPANY=2
#   People per company preselected for "People at my companies" pulls (most senior first)
COMPANY_LIST_MAX=2000
#   Largest company list one pull accepts
COMPANY_BATCH=100
#   Companies per Seamless search (Seamless allows up to 100)
RESLICE_FULL_SHARE=50
#   Only used when Seamless doesn't say how many people match: when this % of a batch's companies already have enough people, search the rest again without them
RESLICE_SMART=1
#   2.2: leave companies that already have enough people out of the next search as soon as that costs less than it saves (searching again shows some people a second time, and Seamless charges for those rows again)
RESLICE_MAX_TIMES=8
#   Most times one batch of companies is searched again
EXTRA_TRIES_PER_COMPANY=1
#   2.2: when someone at a company comes back with no email, Lead Puller may pay for up to this many more people there (so the company still gets its people); 0 = never

# ---- Search --------------------------------------------------------------------
LOCATION_APPLIES_TO=contact
#   Default "Location applies to": contact = person's location (recommended), company, bothOR, bothAND
PAGE_SIZE=50
#   Max people per search page (pages are sized to what's still needed)
RESEARCH_BATCH=100
#   Max people sent for research per call (Seamless max 500)
POLL_SECONDS=4
#   Seconds between checks for research results (free)
RATE_LIMIT_PER_MIN=55
#   Calls per minute per endpoint (Seamless allows 60 per organization)
RESEARCH_WAIT_MINUTES=15
#   Wait this long for slow research answers, then finish without them
LATE_ANSWER_HOURS=24
#   Keep checking (free) for answers that arrive late, for this many hours
LATE_POLL_MINUTES=5
#   How often to check for late answers
ERROR_PAUSE_AFTER=5
#   Pause a pull after this many Seamless errors in a row
DNS_TIMEOUT_SECONDS=3
#   Wait this long for the email-server check (a timeout never skips anyone)
DNS_CACHE_DAYS=30
#   Days to remember the email-server check per domain

# ---- Downloads -----------------------------------------------------------------
EMAIL_PICK=best
#   best = per person the email with the best status, then highest confidence; seamless = Seamless's primary email
DEFAULT_COLUMNS=email,first_name,last_name,company
#   Columns of the "Download for AnavMail" file, in order
TABLE_PAGE_SIZE=50
#   Rows per page in tables

# ---- Advanced ------------------------------------------------------------------
IMPORT_OLD_DATABASE=1
#   On the first start, copy everyone already paid for, the do-not-pull list and the Seamless accounts from the old Lead Puller database (leadpuller.db in DATA_DIR), so nobody is paid for again
SEAMLESS_BASE_URL=https://api.seamless.ai/api/client/v1
#   Seamless API address
# DATA_DIR=/data    # Folder for the database (docker-compose sets /data)
