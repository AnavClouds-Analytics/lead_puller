# Copy to .env and fill in. Everything except ADMIN_USERS can also be set in the app's Settings page.
# Logins: email:password pairs, comma-separated, one per team member (same format as AnavMail).
ADMIN_USERS=you@anavcloudsoftwares.com:change-me-to-a-long-password
SEAMLESS_API_KEY=
ANTHROPIC_API_KEY=
# Set to 1 once the app is served over HTTPS
COOKIE_SECURE=1
