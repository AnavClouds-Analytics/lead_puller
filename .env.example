# ============================================================================
#  Lead Puller settings. Copy this file to .env and fill it in.
#  To change anything later: edit the line here, then run   docker compose up -d
#  (a plain "docker compose restart" does NOT re-read this file).
#  No code changes are ever needed for these.
# ============================================================================

# ---- Login ------------------------------------------------------------------
# APP_PASSWORD=change-me-to-a-long-password
ADMIN_USERS=a@x.com:pw1
SESSION_DAYS=30            # days before you must log in again
COOKIE_SECURE=1            # 1 once the site is on HTTPS (it should be); 0 only for local testing

# ---- Keys -------------------------------------------------------------------
SEAMLESS_API_KEY=          # Seamless -> Settings -> Public API -> API Key
ANTHROPIC_API_KEY=         # console.anthropic.com -> API Keys
CLAUDE_MODEL=claude-sonnet-5-5        # turns your request into filters
CLAUDE_FAST_MODEL=claude-haiku-5-5    # rates how well each person fits

# ---- Spending and rules -----------------------------------------------------
MONTHLY_CREDIT_BUDGET=2000 # max Seamless credits this tool may spend per calendar month (0 = no limit)
MAX_PER_COMPANY=3          # default max people per company in one pull (changeable per pull)
COMPANY_COOLDOWN_DAYS=90   # skip companies pulled in the last N days, across all pulls (0 = off)
FIT_CHECK=1                # 1 = Claude rates each person against your request (no Seamless credits)
CONTINUE_SAME_SEARCH=1     # 1 = re-running the same filters starts where the last run stopped

# ---- Seamless API behaviour (leave as is unless Seamless changes its limits) --
PREVIEW_SIZE=25            # people fetched by Preview (1 credit per 10)
PAGE_SIZE=50               # people per search page while collecting
RESEARCH_BATCH=100         # people sent for research per call (Seamless max 500)
POLL_SECONDS=4             # seconds between checks for research results (Seamless suggests 2-5)
RATE_LIMIT_PER_MIN=55      # calls per minute per endpoint (Seamless allows 60 for your whole org)
SEARCH_SPEND_GUARD=4       # stop collecting if search credits exceed (target / 10) x this
ORG_LOOKBACK_DAYS=730      # how far back "Fill in from Seamless saved contacts" looks
ORG_LOOKUP_MAX_PAGES=60    # max pages of 500 saved contacts read per fill-in
